{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "functions": {
    "api/index.js": { "includeFiles": "dist/templates/**" }
  },
  "rewrites": [
    { "source": "/writing", "destination": "/api/index" },
    { "source": "/writing/:path*", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/api/index" },
    { "source": "/dashboard/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/templates/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
